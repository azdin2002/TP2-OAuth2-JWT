# Java / Maven
# ==============================
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven wrapper: keep wrapper scripts and configuration
# (Do not ignore .mvn/wrapper)

# ==============================
# Spring Boot / logs
# ==============================
*.log
logs/
.spring-boot-devtools.properties

# ==============================
# RSA private keys and secrets
# ==============================
**/privateKey.pem
**/*private*.pem
.env
.env.*
!.env.example
secrets/
**/secrets/

# Public key is intentionally NOT ignored.
# publicKey.pem may be committed if needed by compte-service.

